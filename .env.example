ANTHROPIC_API_KEY=sk-ant-...
OBSIDIAN_VAULT_PATH=./vault
PORT=3000

# Cloud deploy settings
GIT_PUSH=false
VAULT_REPO=https://github.com/user/obsidian-vault.git
AUTH_PATH=./auth

# ---------------------------------------------------------------------------
# Captura de CRM por áudio (Z-API -> Groq -> Claude -> Pipefy)
# Sem estas variáveis o pipeline do Obsidian sobe normalmente e o CRM fica off.
# ---------------------------------------------------------------------------
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
# Só áudio deste número vira card (o chip é compartilhado com o Zona Sul)
OWNER_PHONE=5521999999999
# A Z-API aceita um webhook de recebimento por instância: repassa o payload
# para o endpoint do outro projeto, senão apontar o weblink para cá o desliga.
ZAPI_FORWARD_URL=

GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=pt

PIPEFY_TOKEN=
PIPEFY_PIPE_ID=

# Guardas
MAX_AUDIO_SECONDS=600
MAX_MESSAGE_AGE_MINUTES=10

# Desliga a sessão de QR code do whatsapp-web.js (útil para testar só o CRM)
ENABLE_WHATSAPP_WEB=true
